<?xml version="1.0" encoding="UTF-8"?>
<!-- Cartella dei dati utente di Windows: %APPDATA%\Code (code.visualstudio.com, disinstallazione), Code - Insiders (profili), VSCodium (documentazione di migrazione), Cursor (forum ufficiale), Windsurf (documentazione, percorso precedente). Solo le sottocartelle di cache e i log; User\History, Local Storage, Workspaces, Backups e le impostazioni non si toccano. -->
<cleaner id="vscode" os="windows">
  <label>VS Code and derivatives</label>
  <description>Cache and logs of Visual Studio Code, Code - Insiders, VSCodium, Cursor and Windsurf. Does not touch settings, local history, Local Storage, workspaces or installed extensions.</description>
  <running type="exe" os="windows" same_user="true">Code.exe</running>
  <running type="exe" os="windows" same_user="true">Code - Insiders.exe</running>
  <running type="exe" os="windows" same_user="true">VSCodium.exe</running>
  <running type="exe" os="windows" same_user="true">Cursor.exe</running>
  <running type="exe" os="windows" same_user="true">Windsurf.exe</running>
  <var id="editors">
    <value>%AppData%\Code</value>
    <value>%AppData%\Code - Insiders</value>
    <value>%AppData%\VSCodium</value>
    <value>%AppData%\Cursor</value>
    <value>%AppData%\Windsurf</value>
  </var>
  <option id="cache">
    <label>Editor caches</label>
    <description>Removes Cache, CachedData, Code Cache, GPUCache and the downloaded extension packages (CachedExtensionVSIXs).</description>
    <warning>Close the editor: the first launch after reopening may be slower.</warning>
    <action command="delete" search="walk.all" path="$$editors$$\Cache"/>
    <action command="delete" search="walk.all" path="$$editors$$\CachedData"/>
    <action command="delete" search="walk.all" path="$$editors$$\Code Cache"/>
    <action command="delete" search="walk.all" path="$$editors$$\GPUCache"/>
    <action command="delete" search="walk.all" path="$$editors$$\CachedExtensionVSIXs"/>
  </option>
  <option id="logs">
    <label>Editor logs</label>
    <description>Removes the editor session logs.</description>
    <warning>Close the editor. You lose the logs useful for diagnosing recent problems.</warning>
    <action command="delete" search="walk.all" path="$$editors$$\logs"/>
  </option>
</cleaner>
