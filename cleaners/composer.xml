<?xml version="1.0" encoding="UTF-8"?>
<!-- Composer: solo le tre cartelle di cache documentate (files, repo, vcs) dentro COMPOSER_CACHE_DIR
     o %LocalAppData%\Composer. Così config.json e auth.json non entrano mai, nemmeno quando la cache
     è stata messa nella stessa cartella di COMPOSER_HOME. Il vendor globale non si tocca. -->
<cleaner id="composer" os="windows">
  <label>Composer cache</label>
  <description>Package archives, repository metadata and VCS clones in Composer's cache. Does not touch config.json, auth.json or global packages.</description>
  <var id="composer_files">
    <value>%COMPOSER_CACHE_DIR%\files</value>
    <value>%LOCALAPPDATA%\Composer\files</value>
  </var>
  <var id="composer_repo">
    <value>%COMPOSER_CACHE_DIR%\repo</value>
    <value>%LOCALAPPDATA%\Composer\repo</value>
  </var>
  <var id="composer_vcs">
    <value>%COMPOSER_CACHE_DIR%\vcs</value>
    <value>%LOCALAPPDATA%\Composer\vcs</value>
  </var>
  <option id="cache">
    <label>Composer cache</label>
    <description>Removes package zip archives (files), repository metadata (repo) and VCS clones (vcs).</description>
    <warning>Packages are re-downloaded on the next `composer install` or `composer update`: network required.</warning>
    <action command="delete" search="walk.all" path="$$composer_files$$"/>
    <action command="delete" search="walk.all" path="$$composer_repo$$"/>
    <action command="delete" search="walk.all" path="$$composer_vcs$$"/>
  </option>
</cleaner>
