{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Xiox",
  "version": "0.1.0",
  "identifier": "dev.xiox.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1422",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Xiox",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 560,
        "theme": "Dark",
        "backgroundColor": "#0b0416",
        "visible": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost; img-src 'self' data:; font-src 'self'; object-src 'none'; frame-src 'none'; base-uri 'none'; form-action 'none'",
      "capabilities": [
        "main"
      ]
    }
  },
  "bundle": {
    "active": false
  }
}
