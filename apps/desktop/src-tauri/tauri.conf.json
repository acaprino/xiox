{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Xiox",
  "version": "0.4.0",
  "identifier": "dev.xiox.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1422",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "Xiox",
        "width": 1280,
        "height": 800,
        "minWidth": 500,
        "minHeight": 540,
        "decorations": false,
        "transparent": true,
        "shadow": true,
        "backgroundColor": "#00000000",
        "windowEffects": { "effects": ["acrylic"], "color": [12, 17, 29, 204] },
        "visible": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost; img-src 'self' data:; font-src 'self'; object-src 'none'; frame-src 'none'; base-uri 'none'; form-action 'none'",
      "capabilities": [
        "main"
      ]
    }
  },
  "bundle": {
    "active": false
  }
}
